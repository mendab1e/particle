#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'availability'

project_root = File.expand_path('..', __dir__)
default_config = ENV.fetch('AVAILABILITY_CONFIG', File.join(project_root, 'config', 'availability.yml'))
args = ['generate', '--config', default_config,
        '--output', File.join(project_root, 'public'), *ARGV]
exit Availability::CLI.new(args: args).run
