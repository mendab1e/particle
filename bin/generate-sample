#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'availability'

project_root = File.expand_path('..', __dir__)
config_path = File.join(project_root, 'examples', 'sample.yml')
calendar_path = File.join(project_root, 'examples', 'sample.ics')
output_dir = File.join(project_root, 'docs', 'sample')
template_path = File.join(project_root, 'templates', 'index.html.erb')
favicon_path = File.join(project_root, 'assets', 'favicon.svg')

sample_fetcher = Object.new
sample_calendar = File.binread(calendar_path)
sample_fetcher.define_singleton_method(:fetch) do |*_arguments|
  sample_calendar
end

Availability::Application.new(
  config_path: config_path,
  output_dir: output_dir,
  template_path: template_path,
  favicon_path: favicon_path,
  fetcher: sample_fetcher,
  clock: -> { Time.utc(2026, 8, 24, 8, 0, 0) }
).run
