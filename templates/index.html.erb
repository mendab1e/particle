<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="color-scheme" content="light dark">
  <title>Particle — from Party Cal</title>
  <style>
    :root {
      color-scheme: light dark;
      --background: #f4f4f1;
      --surface: #ffffff;
      --text: #242522;
      --muted: #73756f;
      --border: #dedfd9;
      --accent: #1f6b4f;
      --accent-soft: #e2f2eb;
      --empty: #a3a59f;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      line-height: 1.45;
    }

    main {
      width: min(100% - 2rem, 68rem);
      margin: 0 auto;
      padding: 3.5rem 0 2rem;
    }

    header { margin-bottom: 2rem; }

    h1 {
      margin: 0;
      font-size: clamp(2rem, 7vw, 3.6rem);
      font-weight: 720;
      letter-spacing: -0.045em;
      line-height: 1;
    }

    .intro {
      max-width: 38rem;
      margin: 0.85rem 0 0;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .week + .week { margin-top: 2rem; }

    .week-title {
      margin: 0 0 0.65rem;
      color: var(--muted);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }

    .days {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.65rem;
    }

    .day {
      min-height: 10.5rem;
      padding: 1rem;
      border: 1px solid var(--border);
      border-radius: 0.85rem;
      background: var(--surface);
    }

    .day.empty { color: var(--empty); }

    .day.today {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px var(--accent);
    }

    .date {
      margin: 0 0 0.85rem;
      font-size: 0.9rem;
      font-weight: 690;
      line-height: 1.25;
    }

    .today-label {
      display: inline-block;
      margin-top: 0.3rem;
      color: var(--accent);
      font-size: 0.68rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .slots {
      display: flex;
      flex-wrap: wrap;
      gap: 0.42rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .slot {
      padding: 0.42rem 0.55rem;
      border-radius: 0.45rem;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 0.84rem;
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      white-space: nowrap;
    }

    .none {
      margin: 0;
      font-size: 0.84rem;
    }

    .disabled {
      max-width: 40rem;
      padding: 1.4rem;
      border: 1px solid var(--border);
      border-radius: 0.85rem;
      background: var(--surface);
    }

    .disabled h2 { margin: 0 0 0.35rem; font-size: 1.1rem; }
    .disabled p { margin: 0; color: var(--muted); }

    footer {
      margin-top: 2.25rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.8rem;
    }

    @media (max-width: 58rem) {
      main { padding-top: 2.25rem; }
      .days { grid-template-columns: 1fr; gap: 0.5rem; }
      .day {
        display: grid;
        grid-template-columns: minmax(8.5rem, 0.7fr) 1.3fr;
        align-items: start;
        min-height: 0;
        padding: 0.9rem;
      }
      .date { margin: 0; }
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --background: #171916;
        --surface: #20231f;
        --text: #f1f2ed;
        --muted: #a6aaa2;
        --border: #3a3e38;
        --accent: #80d4ad;
        --accent-soft: #193e2d;
        --empty: #777b74;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <h1>Particle</h1>
      <p class="intro">From Party Cal: shared availability <%= h period_description %>.</p>
    </header>

    <% if enabled -%>
      <% days.each_slice(7).with_index(1) do |week, index| -%>
        <section class="week" aria-labelledby="week-<%= index %>">
          <h2 class="week-title" id="week-<%= index %>">Week <%= index %></h2>
          <div class="days">
            <% week.each do |day| -%>
              <article class="day<%= " empty" if day.slots.empty? %><%= " today" if day.date == today %>">
                <h3 class="date">
                  <%= h format_date(day.date) %>
                  <% if day.date == today -%><span class="today-label">Today</span><% end -%>
                </h3>
                <% if day.slots.empty? -%>
                  <p class="none">No availability</p>
                <% else -%>
                  <ul class="slots" aria-label="Available times">
                    <% day.slots.each do |slot| -%>
                      <li class="slot"><%= h format_time(slot.starts_at) %>–<%= h format_time(slot.ends_at) %></li>
                    <% end -%>
                  </ul>
                <% end -%>
              </article>
            <% end -%>
          </div>
        </section>
      <% end -%>
    <% else -%>
      <section class="disabled">
        <h2>Calendar not available</h2>
        <p>Particle is not being shared at the moment.</p>
      </section>
    <% end -%>

    <footer>Particle · from Party Cal · last updated: <%= h updated_at %></footer>
  </main>
</body>
</html>
